# ============================================
# Environment Variables for react-ecommerce-storefront
# ============================================
# Copy this file to `.env` and `.env.local` and fill in your values.
# NEVER commit your actual keys to version control.

# --- Razorpay (Payment Gateway) ---
# Get your keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# --- Clerk (Authentication) ---
# Get your publishable key from: https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# --- Web3Forms (Contact Forms & Notifications) ---
# Get your access key from: https://web3forms.com
VITE_WEB3FORMS_KEY=your_web3forms_access_key_here

# --- Resend (Transactional Emails) ---
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
